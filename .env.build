# Build-time Environment Configuration for Docker Image
# Used during docker build process

# ===== BUILD PROXY CONFIGURATION =====
BUILD_HTTP_PROXY=http://192.168.31.5:7890
BUILD_HTTPS_PROXY=http://192.168.31.5:7890
BUILD_NO_PROXY=localhost,127.0.0.1

# ===== BUILD SETTINGS =====
BUILD_NODE_ENV=production
BUILD_NEXT_TELEMETRY_DISABLED=1

# ===== DOCKER BUILD ARGUMENTS =====
# These are passed as build args to Dockerfile
BUILD_DATE=$(date -u +'%Y-%m-%dT%H:%M:%SZ')
BUILD_VERSION=latest
BUILD_COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")