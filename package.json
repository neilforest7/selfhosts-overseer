{
  "name": "selfhost-overseer",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -k -n web,server -c green,blue \"cd apps/web && npm run dev\" \"cd apps/server && npm run start:dev\"",
    "dev:web": "cd apps/web && npm run dev",
    "dev:server": "cd apps/server && npm run start:dev",
    "build": "cd apps/server && npm run build && cd ../web && npm run build",
    "build:web": "cd apps/web && npm run build",
    "build:server": "cd apps/server && npm run build",
    "start": "cd apps/server && npm run start:prod",
    "db:generate": "cd apps/server && npm run prisma:generate",
    "db:push": "cd apps/server && npm run prisma:push",
    "db:migrate": "cd apps/server && npm run prisma:migrate",
    "lint": "cd apps/web && npm run lint && cd ../server && npm run lint",
    "type-check": "cd apps/web && npm run type-check && cd ../server && npm run type-check"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tabler/icons-react": "^3.34.1",
    "@tanstack/react-query": "^5.87.4",
    "@tanstack/react-table": "^8.21.3",
    "@types/uuid": "^10.0.0",
    "uuid": "^13.0.0"
  }
}
