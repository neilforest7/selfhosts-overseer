# Production Environment Configuration for Self-Host Serv Agent
# Copy this file to .env and customize with your values

# ===== APPLICATION SETTINGS =====
IMAGE_NAME=selfhost-serv-agent
IMAGE_TAG=latest
CONTAINER_NAME=selfhost-app
RESTART_POLICY=unless-stopped

# ===== NETWORK & PORTS =====
FRONTEND_PORT=3000
BACKEND_PORT=3001
NETWORK_SUBNET=172.25.0.0/16
NETWORK_NAME=selfhost-network

# ===== RESOURCE LIMITS =====
# Application
APP_CPU_LIMIT=2.0
APP_MEMORY_LIMIT=2G
APP_CPU_RESERVATION=0.5
APP_MEMORY_RESERVATION=1G

# PostgreSQL
POSTGRES_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=1G
POSTGRES_CPU_RESERVATION=0.2
POSTGRES_MEMORY_RESERVATION=256M

# Redis
REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=512M
REDIS_CPU_RESERVATION=0.1
REDIS_MEMORY_RESERVATION=128M

# ===== DATABASE CONFIGURATION =====
POSTGRES_USER=selfhost
POSTGRES_PASSWORD=secure_postgres_password_123
POSTGRES_DB=selfhost
POSTGRES_PORT=5432
POSTGRES_CONTAINER_NAME=selfhost-postgres
POSTGRES_VOLUME_NAME=selfhost-postgres-data
DATABASE_SSL_MODE=prefer

# ===== REDIS CONFIGURATION =====
REDIS_PASSWORD=secure_redis_password_123
REDIS_PORT=6379
REDIS_CONTAINER_NAME=selfhost-redis
REDIS_VOLUME_NAME=selfhost-redis-data
REDIS_MAX_MEMORY=512mb

# ===== AUTHENTICATION & SECURITY =====
USERNAME=admin
PASSWORD=secure_admin_password_123
JWT_SECRET=very_secure_jwt_secret_key_32_characters_min
ENCRYPTION_KEY=very_secure_encryption_key_32_characters_min

# ===== API & FRONTEND CONFIGURATION =====
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=nextauth_secret_key_32_characters_minimum

# ===== EMAIL CONFIGURATION (Optional) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@your-domain.com

# ===== CLOUDFLARE CONFIGURATION (Optional) =====
CLOUDFLARE_API_KEY=your_cloudflare_api_key
CLOUDFLARE_EMAIL=your-cloudflare-email

# ===== DEVELOPMENT TOOLS (Optional) =====
PGWEB_PORT=8081
PGWEB_CONTAINER_NAME=selfhost-pgweb

# ===== DATABASE INITIALIZATION CONFIGURATION =====
DB_CONNECTION_MAX_ATTEMPTS=20
DB_CONNECTION_RETRY_DELAY=3000
AUTH_INIT_MAX_RETRIES=10
AUTH_INIT_RETRY_DELAY=3000
AUTH_INIT_READY_CHECK_INTERVAL=2000

# ===== SSH CONFIGURATION (Optional) =====
SSH_KEYS_VOLUME_NAME=selfhost-ssh-keys

# ===== BUILD PROXY CONFIGURATION (Optional) =====
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1