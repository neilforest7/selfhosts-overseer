# Production Environment Variables
# Copy this file to .env.production and fill in your values

# Database Configuration
POSTGRES_PASSWORD=your_secure_postgres_password

# Redis Configuration  
REDIS_PASSWORD=your_secure_redis_password

# Authentication Configuration
USERNAME=your_admin_username
PASSWORD=your_secure_password
JWT_SECRET=your_very_secure_jwt_secret_key_minimum_32_characters
ENCRYPTION_KEY=your_very_secure_encryption_key_minimum_32_characters

# NextAuth Configuration
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=your_nextauth_secret_key

# Observability (Optional)
GRAFANA_PASSWORD=your_grafana_admin_password

# SSL Configuration (for nginx)
SSL_CERT_PATH=/etc/nginx/ssl/your-domain.com.crt
SSL_KEY_PATH=/etc/nginx/ssl/your-domain.com.key

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@your-domain.com

# Optional: Cloudflare API (for DNS management)
CLOUDFLARE_API_KEY=your_cloudflare_api_key
CLOUDFLARE_EMAIL=your-cloudflare-email