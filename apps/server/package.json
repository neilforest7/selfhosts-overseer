{
  "name": "@selfhost-serv-agent/server",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "build": "tsc -p tsconfig.json",
    "start:dev": "ts-node-dev --respawn --transpile-only --require dotenv/config src/main.ts",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:validation": "jest --config jest.validation.config.js",
    "test:validation:coverage": "jest --config jest.validation.config.js --coverage",
    "report:validation": "tsx scripts/generate-validation-report.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init --skip-seed",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "migrate:frp-relationships": "tsx scripts/migrate-frp-relationships.ts",
    "migrate:frp-relationships:dry-run": "tsx scripts/migrate-frp-relationships.ts --dry-run",
    "validate:frp-topology": "tsx scripts/validate-frp-topology.ts",
    "test:frp-discovery-order": "tsx scripts/test-frp-discovery-order.ts",
    "debug:frp-state": "tsx scripts/debug-frp-state.ts",
    "debug:frp-state:test-resolution": "tsx scripts/debug-frp-state.ts --test-resolution",
    "migrate:automation-data": "tsx scripts/migrate-automation-data.ts",
    "validate:migration-status": "tsx scripts/validate-migration-status.ts",
    "fix:compatibility": "tsx scripts/fix-compatibility-issues.ts",
    "audit:legacy-rules": "tsx scripts/audit-legacy-rules.ts",
    "seed:automation-data": "tsx scripts/seed-automation-data.ts",
    "seed:plugin-metadata": "tsx scripts/seed-plugin-metadata.ts",
    "seed:plugin-metadata:dry-run": "tsx scripts/seed-plugin-metadata.ts --dry-run"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@nestjs/bullmq": "^10.1.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-fastify": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.4.20",
    "@nestjs/schedule": "^3.0.4",
    "@nestjs/websockets": "^10.3.0",
    "@prisma/client": "^5.17.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.1",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.7.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cron-parser": "^5.3.0",
    "dotenv": "^17.2.1",
    "eventemitter2": "^6.4.9",
    "fastify": "^4.28.1",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "ini": "^5.0.0",
    "js-yaml": "^4.1.0",
    "json-rules-engine": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "2",
    "nodemailer": "^7.0.6",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "sqlite3": "^5.1.7",
    "tar-stream": "^3.1.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.20",
    "@types/express": "^5.0.3",
    "@types/ini": "^4.1.1",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.30",
    "@types/sqlite3": "^3.1.11",
    "@types/supertest": "^6.0.2",
    "@types/tar-stream": "^3.1.4",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prisma": "^5.17.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.5.4"
  }
}
