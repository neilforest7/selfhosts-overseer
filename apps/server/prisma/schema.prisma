generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HostRole {
  local
  remote
}

enum SshAuthMethod {
  password
  privateKey
}

enum HostStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

enum ImageUpdateStatus {
  UNKNOWN // 未知状态
  UP_TO_DATE // 完全最新
  CONTAINER_OUTDATED // 容器过时（本地镜像已更新，但容器未重启）
  IMAGE_OUTDATED // 镜像过时（远程有新版本，但本地未拉取）
  BOTH_OUTDATED // 都过时（远程有新版本，且容器也未使用最新本地镜像）
}

model AppSetting {
  key   String @id
  value String
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  passwordHash  String
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuthSetting {
  key   String @id
  value String
}

model Host {
  id                      String                  @id @default(cuid())
  name                    String
  address                 String
  sshUser                 String
  port                    Int?
  tags                    String[]
  sshOptions              Json?
  sshAuthMethod           SshAuthMethod           @default(password)
  sshPassword             String?
  sshPrivateKey           String?
  sshPrivateKeyPassphrase String?
  role                    HostRole                @default(local)
  status                  HostStatus              @default(UNKNOWN)
  lastOnlineAt            DateTime?
  lastOfflineAt           DateTime?
  lastConnectivityCheck   DateTime?
  // Platform information for Docker operations
  dockerPlatformArch      String? // e.g., "amd64", "arm64"
  dockerPlatformOS        String? // e.g., "linux", "windows"
  dockerPlatformDetected  Boolean                 @default(false)
  dockerLoginStatus       Boolean                 @default(false) // Track if Docker login is active
  dockerLoginExpiry       DateTime? // When Docker login expires
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  containers              Container[]
  operationLogEntries     OperationLogEntry[]
  activityLogs            ActivityLog[]
  connectivityChecks      HostConnectivityCheck[]
}

// Unified system log table
model SystemLog {
  id        String   @id @default(cuid())
  ts        DateTime @default(now())
  category  String
  level     String
  stream    String
  source    String?
  hostId    String?
  hostLabel String?
  content   String
  metadata  Json?

  @@index([category, ts])
  @@index([hostId, ts])
  @@index([source, ts])
  @@index([ts])
}

model Container {
  id           String  @id @default(cuid())
  hostId       String
  containerId  String
  name         String
  state        String?
  status       String?
  restartCount Int?
  imageName    String?
  imageTag     String?

  // 容器实际运行的镜像信息
  containerImageDigest  String? // 容器启动时使用的镜像摘要
  containerImageId      String? // 容器镜像ID
  containerImageCreated DateTime? // 容器镜像创建时间

  // 本地最新镜像信息
  localImageDigest  String? // 本地最新镜像摘要（通过 docker images 获取）
  localImageId      String? // 本地最新镜像ID
  localImageCreated DateTime? // 本地最新镜像创建时间

  // 远程镜像信息（保留现有字段）
  repoDigest   String? // 保留向后兼容，逐步迁移到 localImageDigest
  remoteDigest String? // 远程最新镜像摘要

  // 更新状态
  imageUpdateStatus ImageUpdateStatus @default(UNKNOWN)
  updateAvailable   Boolean           @default(false) // 保留向后兼容
  updateCheckedAt   DateTime?

  createdAt          DateTime        @default(now())
  startedAt          DateTime?
  isComposeManaged   Boolean         @default(false)
  composeProject     String?
  composeService     String?
  composeWorkingDir  String?
  composeGroupKey    String?
  composeFolderName  String?
  composeConfigFiles Json?
  // New relation to ComposeProject entity (explicit project modeling)
  composeProjectId   String?
  composeProjectRef  ComposeProject? @relation(fields: [composeProjectId], references: [id], onDelete: SetNull)
  runCommand         String?
  ports              Json?
  mounts             Json?
  networks           Json?
  labels             Json?
  manualPortMapping  Json?
  host               Host            @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@unique([hostId, containerId])
  @@index([hostId, composeGroupKey])
  @@index([imageUpdateStatus])
}

model ReverseProxyRoute {
  id                    String    @id @default(cuid())
  hostId                String
  provider              String
  type                  String
  domain                String
  forwardHost           String?
  forwardPort           Int?
  enabled               Boolean   @default(true)
  certificateId         String?
  certExpiresAt         DateTime?
  sslForced             Boolean   @default(false)
  hstsEnabled           Boolean   @default(false)
  hstsSubdomains        Boolean   @default(false)
  http2Support          Boolean   @default(false)
  allowWebsocketUpgrade Boolean   @default(false)
  blockExploits         Boolean   @default(false)
  cachingEnabled        Boolean   @default(false)
  lastSyncedAt          DateTime?

  @@unique([hostId, domain])
}

model Certificate {
  id           String    @id @default(cuid())
  provider     String
  cn           String
  sans         String[]
  issuer       String?
  notBefore    DateTime?
  notAfter     DateTime?
  autoRenew    Boolean   @default(true)
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
}

model HostNpmConfig {
  hostId               String   @id
  enabled              Boolean  @default(false)
  dbType               String   @default("sqlite")
  connectionMode       String   @default("container-local")
  containerName        String?
  sqlitePath           String?  @default("/data/database.sqlite")
  mysqlUseContainerEnv Boolean? @default(false)
  updatedAt            DateTime @updatedAt
}

model ComposeProject {
  id                  String    @id @default(cuid())
  hostId              String?
  project             String
  workingDir          String
  configFiles         String[]
  effectiveConfigHash String?
  lastSyncedAt        DateTime?

  // Reverse relation: containers in this compose project
  containers Container[]

  @@unique([hostId, project, workingDir])
}

model FrpsConfig {
  id             String      @id @default(cuid())
  hostId         String
  containerId    String
  bindPort       Int?
  vhostHttpPort  Int?
  vhostHttpsPort Int?
  subdomainHost  String?
  rawConfig      Json?
  lastSyncedAt   DateTime?
  proxies        FrpcProxy[]
}

model FrpcProxy {
  id            String    @id @default(cuid())
  hostId        String
  containerId   String
  frpsConfigId  String? // Made optional to support pending state
  name          String
  type          String
  localIp       String
  localPort     Int
  remotePort    Int
  subdomain     String?
  customDomains String[]
  rawConfig     Json?
  lastSyncedAt  DateTime?

  // Two-phase sync support fields
  syncStatus        String    @default("pending") // 'pending' | 'linked' | 'failed'
  pendingServerAddr String? // Temporary storage for FRPS server address
  pendingServerPort Int? // Temporary storage for FRPS server port
  lastLinkAttempt   DateTime? // Track when last link attempt was made
  linkErrorMessage  String? // Store error message if linking fails

  frps FrpsConfig? @relation(fields: [frpsConfigId], references: [id], onDelete: Cascade)
}

model OperationLog {
  id               String              @id @default(cuid())
  title            String
  status           OperationStatus     @default(PENDING)
  triggerType      TriggerType         @default(MANUAL)
  triggerContext   Json?
  context          Json?
  startTime        DateTime            @default(now())
  endTime          DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  entries          OperationLogEntry[]
  automationRuleId String?
  automationRule   AutomationRule?     @relation(fields: [automationRuleId], references: [id], onDelete: SetNull)

  // New relationship to RuleExecution
  ruleExecutions RuleExecution[]
}

model OperationLogEntry {
  id             String       @id @default(cuid())
  timestamp      DateTime     @default(now())
  stream         String
  content        String       @db.Text
  operationLog   OperationLog @relation(fields: [operationLogId], references: [id], onDelete: Cascade)
  operationLogId String
  host           Host?        @relation(fields: [hostId], references: [id], onDelete: SetNull)
  hostId         String?
}

// ============================================================================
// CORE AUTOMATION ENTITIES
// ============================================================================

model AutomationRule {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isEnabled   Boolean @default(true)
  priority    Int     @default(0)

  // Template and inheritance support
  templateId   String?
  template     RuleTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  isTemplate   Boolean          @default(false)
  parentRuleId String?
  parentRule   AutomationRule?  @relation("RuleInheritance", fields: [parentRuleId], references: [id])
  childRules   AutomationRule[] @relation("RuleInheritance")



  // Metadata
  tags     String[]
  category String?
  version  String   @default("1.0.0")



  // Relationships
  triggers      RuleTrigger[]
  events        RuleEvent[]
  notifications RuleNotification[]
  dependencies  RuleDependency[]   @relation("DependentRule")
  dependents    RuleDependency[]   @relation("RequiredRule")

  // Execution tracking
  executions RuleExecution[]
  metrics    RuleMetrics[]
  operations OperationLog[] // Keep existing relationship

  // Timestamps
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastExecutedAt DateTime?

  @@index([isEnabled, priority])
  @@index([templateId])
  @@index([category])
}

model RuleTemplate {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  category    String
  version     String  @default("1.0.0")

  // Template configuration
  triggerTemplates      TriggerTemplate[]
  eventTemplates        EventTemplate[]
  notificationTemplates NotificationTemplate[]

  // Template metadata
  author        String?
  tags          String[]
  isPublic      Boolean  @default(false)
  downloadCount Int      @default(0)

  // Usage tracking
  rules AutomationRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
}

// ============================================================================
// TRIGGERS
// ============================================================================

model RuleTrigger {
  id     String         @id @default(cuid())
  ruleId String
  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  // Trigger configuration
  type        String // 'cron', 'webhook', 'event', etc.
  name        String?
  description String?
  isEnabled   Boolean @default(true)
  priority    Int     @default(0)

  // Plugin information
  pluginId      String
  pluginVersion String
  plugin        PluginMetadata @relation(fields: [pluginId], references: [id])

  // Configuration
  config     Json
  conditions Json?

  // Execution tracking
  executions TriggerExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ruleId])
  @@index([type])
  @@index([pluginId])
}

model TriggerTemplate {
  id         String       @id @default(cuid())
  templateId String
  template   RuleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  type          String
  name          String
  description   String?
  defaultConfig Json
  configSchema  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
}

// ============================================================================
// EVENTS
// ============================================================================

model RuleEvent {
  id     String         @id @default(cuid())
  ruleId String
  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  // Event configuration
  type        String // 'restart-container', 'execute-command', etc.
  name        String?
  description String?
  isEnabled   Boolean @default(true)
  priority    Int     @default(0)

  // Plugin information
  pluginId      String
  pluginVersion String
  plugin        PluginMetadata @relation(fields: [pluginId], references: [id])

  // Configuration
  params  Json
  options Json? // timeout, retry, etc.

  // Execution tracking
  executions EventExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ruleId])
  @@index([type])
  @@index([pluginId])
}

model EventTemplate {
  id         String       @id @default(cuid())
  templateId String
  template   RuleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  type          String
  name          String
  description   String?
  defaultParams Json
  paramsSchema  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model RuleNotification {
  id     String         @id @default(cuid())
  ruleId String
  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  // Notification configuration
  name        String?
  description String?
  isEnabled   Boolean @default(true)

  // Trigger conditions
  notifyOn NotificationTrigger[] // SUCCESS, FAILURE, ALWAYS, etc.

  // Channel configuration
  channels NotificationChannel[]

  // Template
  templateId String?
  template   NotificationTemplate? @relation(fields: [templateId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ruleId])
}

model NotificationChannel {
  id             String           @id @default(cuid())
  notificationId String
  notification   RuleNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  type      String // 'email', 'slack', 'webhook', etc.
  config    Json // channel-specific configuration
  isEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([notificationId])
}

model NotificationTemplate {
  id           String        @id @default(cuid())
  templateId   String?
  ruleTemplate RuleTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  name        String
  description String?
  type        String // 'email', 'slack', 'webhook'

  // Template content
  subject String?
  body    String
  format  String  @default("plain") // 'plain', 'markdown', 'html'

  // Usage tracking
  notifications RuleNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

// ============================================================================
// PLUGIN SYSTEM
// ============================================================================

model PluginMetadata {
  id          String  @id @default(cuid())
  name        String  @unique
  displayName String
  description String
  version     String
  author      String?

  // Plugin type and capabilities
  type     PluginType // TRIGGER, EVENT, BOTH
  category String?
  tags     String[]

  // Plugin configuration
  configSchema Json?
  dependencies String[] // Other plugin IDs

  // Status and health
  isEnabled Boolean      @default(true)
  isBuiltIn Boolean      @default(false)
  status    PluginStatus @default(ACTIVE)

  // Usage tracking
  triggers      RuleTrigger[]
  events        RuleEvent[]
  installations PluginInstallation[]

  // Versioning
  previousVersions   String[]
  compatibleVersions String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isEnabled])
  @@index([status])
}

model PluginInstallation {
  id       String         @id @default(cuid())
  pluginId String
  plugin   PluginMetadata @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  version   String
  config    Json?
  isEnabled Boolean @default(true)

  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([pluginId])
}

// ============================================================================
// RULE DEPENDENCIES AND WORKFLOWS
// ============================================================================

model RuleDependency {
  id              String @id @default(cuid())
  dependentRuleId String
  requiredRuleId  String

  dependentRule AutomationRule @relation("DependentRule", fields: [dependentRuleId], references: [id], onDelete: Cascade)
  requiredRule  AutomationRule @relation("RequiredRule", fields: [requiredRuleId], references: [id], onDelete: Cascade)

  // Dependency configuration
  type      DependencyType @default(PREREQUISITE)
  condition Json? // Conditions for dependency satisfaction

  createdAt DateTime @default(now())

  @@unique([dependentRuleId, requiredRuleId])
  @@index([dependentRuleId])
  @@index([requiredRuleId])
}

// ============================================================================
// EXECUTION TRACKING AND ANALYTICS
// ============================================================================

model RuleExecution {
  id     String         @id @default(cuid())
  ruleId String
  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  // Execution context
  triggeredBy String? // 'manual', 'schedule', 'webhook', etc.
  triggerData Json?

  // Execution details
  status     ExecutionStatus
  startedAt  DateTime        @default(now())
  finishedAt DateTime?
  duration   Int? // milliseconds

  // Results
  triggerResults TriggerExecution[]
  eventResults   EventExecution[]

  // Error handling
  error        String?
  errorDetails Json?

  // Operation log reference
  operationLogId String?
  operationLog   OperationLog? @relation(fields: [operationLogId], references: [id])

  @@index([ruleId])
  @@index([status])
  @@index([startedAt])
}

model TriggerExecution {
  id          String        @id @default(cuid())
  executionId String
  execution   RuleExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  triggerId String
  trigger   RuleTrigger @relation(fields: [triggerId], references: [id], onDelete: Cascade)

  // Execution details
  shouldTrigger Boolean
  reason        String?
  triggerData   Json?
  duration      Int? // milliseconds

  // Error handling
  error String?

  executedAt DateTime @default(now())

  @@index([executionId])
  @@index([triggerId])
}

model EventExecution {
  id          String        @id @default(cuid())
  executionId String
  execution   RuleExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  eventId String
  event   RuleEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Execution details
  status   ExecutionStatus
  result   Json?
  duration Int? // milliseconds

  // Error handling
  error        String?
  errorDetails Json?

  executedAt DateTime @default(now())

  @@index([executionId])
  @@index([eventId])
  @@index([status])
}

// ============================================================================
// ANALYTICS AND METRICS
// ============================================================================

model RuleMetrics {
  id     String         @id @default(cuid())
  ruleId String
  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  // Time period
  date DateTime @db.Date
  hour Int? // 0-23 for hourly metrics

  // Execution metrics
  totalExecutions      Int @default(0)
  successfulExecutions Int @default(0)
  failedExecutions     Int @default(0)

  // Performance metrics
  avgExecutionTime Float? // milliseconds
  minExecutionTime Int? // milliseconds
  maxExecutionTime Int? // milliseconds

  // Trigger metrics
  totalTriggers  Int @default(0)
  triggeredCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ruleId, date, hour])
  @@index([ruleId])
  @@index([date])
}

model SystemMetrics {
  id String @id @default(cuid())

  // Time period
  timestamp DateTime @default(now())

  // System-wide metrics
  totalRules      Int
  activeRules     Int
  totalExecutions Int
  successRate     Float

  // Performance metrics
  avgRuleExecutionTime Float
  systemLoad           Float?
  memoryUsage          Float?

  // Plugin metrics
  totalPlugins  Int
  activePlugins Int

  @@index([timestamp])
}



enum OperationStatus {
  PENDING
  RUNNING
  COMPLETED
  ERROR
  CANCELLED
}

enum TriggerType {
  MANUAL
  CRON
  WEBHOOK
  EVENT
  SCHEDULE
}

// ============================================================================
// NEW AUTOMATION ENUMS
// ============================================================================

enum PluginType {
  TRIGGER
  EVENT
  BOTH
}

enum PluginStatus {
  ACTIVE
  INACTIVE
  ERROR
  DEPRECATED
}

enum NotificationTrigger {
  SUCCESS
  FAILURE
  ALWAYS
  WARNING
}

enum DependencyType {
  PREREQUISITE
  CONDITIONAL
  SEQUENTIAL
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT
}



enum ActivityCategory {
  HOST_MANAGEMENT // Host CRUD operations, connection tests
  CONTAINER_LIFECYCLE // Container start/stop/restart/create/delete
  CONTAINER_UPDATE // Container image updates, version changes
  COMPOSE_OPERATION // Docker Compose operations
  FRP_CONFIGURATION // FRP tunnel configuration changes
  REVERSE_PROXY // NPM route changes
  DNS_RESOLUTION // DNS detection and resolution activities
  SYSTEM_OPERATION // System-level operations
  AUTOMATION // Automation rule executions
}

model ActivityLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())

  // Event categorization
  category ActivityCategory
  action   String // e.g., "created", "updated", "deleted", "started", "stopped"

  // Resource identification
  resourceType String // e.g., "host", "container", "frp_config", "reverse_proxy_route"
  resourceId   String? // ID of the affected resource
  resourceName String? // Human-readable name of the resource

  // Context information
  hostId   String? // Associated host (for filtering by host)
  hostName String? // Host name for display

  // Event details
  title       String // Human-readable event title
  description String? // Detailed description
  metadata    Json? // Additional structured data

  // Change tracking
  oldValues Json? // Previous state (for updates)
  newValues Json? // New state (for updates)

  // Relationships
  host Host? @relation(fields: [hostId], references: [id], onDelete: SetNull)

  // Indexing for performance
  @@index([timestamp])
  @@index([category, timestamp])
  @@index([hostId, timestamp])
  @@index([resourceType, timestamp])
  @@index([resourceType, resourceId])
}

model HostConnectivityCheck {
  id           String     @id @default(cuid())
  hostId       String
  status       HostStatus
  responseTime Int? // Response time in milliseconds
  errorMessage String? // Error details if connection failed
  checkedAt    DateTime   @default(now())

  // Relationships
  host Host @relation(fields: [hostId], references: [id], onDelete: Cascade)

  // Indexing for performance
  @@index([hostId, checkedAt])
  @@index([status, checkedAt])
  @@index([checkedAt])
}

// DNS Record Types
enum DnsRecordType {
  A
  AAAA
  CNAME
  MX
  TXT
  NS
  PTR
  SRV
  CAA
}

// DNS Status
enum DnsStatus {
  UNKNOWN
  RESOLVED
  FAILED
  TIMEOUT
  NO_RECORD
}

// DNS Provider Configuration
model DnsProvider {
  id          String  @id @default(cuid())
  name        String  @unique // e.g., "cloudflare", "route53", "dnspod"
  displayName String // e.g., "Cloudflare", "AWS Route 53"
  isEnabled   Boolean @default(true)

  // API Configuration (encrypted storage)
  apiConfig Json // Store API keys, endpoints, etc.

  // Rate limiting configuration
  rateLimitPerMinute Int @default(60)
  timeoutSeconds     Int @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Associated DNS records
  dnsRecords DnsRecord[]

  @@index([isEnabled])
}

// DNS Record Management
model DnsRecord {
  id         String        @id @default(cuid())
  domain     String // Full domain name, e.g., "api.example.com"
  recordType DnsRecordType @default(A)

  // Associated DNS provider
  providerId String
  provider   DnsProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  // Detection configuration
  isEnabled     Boolean @default(true)
  checkInterval Int     @default(300) // Check interval in seconds

  // Current resolution status
  currentIp    String? // Currently resolved IP
  lastCheckAt  DateTime? // Last check time
  lastChangeAt DateTime? // Last change time
  status       DnsStatus @default(UNKNOWN)
  errorMessage String? // Error message

  // Cloudflare-specific metadata (for discovered records)
  cloudflareRecordId String? // Cloudflare's internal record ID
  cloudflareZoneId   String? // Cloudflare zone ID
  cloudflareZoneName String? // Zone name (domain)
  ttl                Int? // TTL value
  proxied            Boolean? // Cloudflare proxy status
  content            String? // Record content/value
  priority           Int? // Priority for MX records
  comment            String? // Cloudflare record comment

  // Discovery metadata
  isDiscovered       Boolean   @default(false) // Whether this record was auto-discovered
  lastSyncAt         DateTime? // Last sync with provider
  providerCreatedAt  DateTime? // Creation date from provider
  providerModifiedAt DateTime? // Last modified date from provider

  // Metadata
  description String?
  tags        String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Resolution history
  resolutions DnsResolution[]

  @@unique([domain, providerId])
  @@index([isEnabled, status])
  @@index([domain])
  @@index([providerId])
  @@index([cloudflareRecordId])
  @@index([cloudflareZoneId])
  @@index([isDiscovered])
}

// DNS Resolution History
model DnsResolution {
  id          String    @id @default(cuid())
  dnsRecordId String
  dnsRecord   DnsRecord @relation(fields: [dnsRecordId], references: [id], onDelete: Cascade)

  // Resolution result
  resolvedIp   String? // Resolved IP address
  responseTime Int? // Response time in milliseconds
  status       DnsStatus
  errorMessage String? // Error details

  // Geographic location information (optional)
  geoLocation Json? // Contains country, city, ISP, etc.

  // Check time
  checkedAt DateTime @default(now())

  @@index([dnsRecordId, checkedAt])
  @@index([checkedAt])
  @@index([status, checkedAt])
}
