# MCP Server Environment Configuration
# Copy this file to .env and customize the values

# ===== MCP SERVER CONFIGURATION =====
MCP_IMAGE_NAME=selfhost-mcp-server
MCP_IMAGE_TAG=latest
MCP_CONTAINER_NAME=selfhost-mcp

# MCP Server Settings
MCP_SERVER_NAME=selfhost-serv-agent
MCP_SERVER_PORT=3002
MCP_LOG_LEVEL=INFO
MCP_API_TIMEOUT=30

# Docker Build Proxy Settings
HTTP_PROXY=http://192.168.31.5:7890
HTTPS_PROXY=http://192.168.31.5:7890
NO_PROXY=localhost,127.0.0.1

# Resource Limits
MCP_CPU_LIMIT=0.5
MCP_MEMORY_LIMIT=512M
MCP_CPU_RESERVATION=0.1
MCP_MEMORY_RESERVATION=128M

# ===== USAGE INSTRUCTIONS =====
# 1. Copy this file to .env in the project root
# 2. Adjust resource limits based on your server capacity
# 3. No authentication required - MCP Server runs without protection
# 4. Start MCP Server with: docker-compose --profile mcp up -d
